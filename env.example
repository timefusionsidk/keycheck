# All optional. Leave empty to disable. Set as environment variables at build time (e.g. Vercel project settings).
# Public site URL, no trailing slash. Enables canonical URL, og:url and sitemap.xml.
VITE_SITE_URL=
# Display ads (Google AdSense). Both must be set for any ad script to load.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT=
# Contact address shown on the Contact page.
VITE_CONTACT_EMAIL=
